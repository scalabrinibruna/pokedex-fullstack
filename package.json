{
  "name": "pokedex-fullstack",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "postinstall": "npm --prefix Front install",
    "back": "cd Back && mvn spring-boot:run",
    "front": "npm --prefix Front run dev",
    "concurrently": "concurrently -n back,front -c blue,green \"npm run back\" \"npm run front\"",
    "dev": "npm run concurrently"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
